{
  "name": "queen-bee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Find every NYT Spelling Bee word from the puzzle letters, with a hints grid",
  "author": "Craig McNaughton",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:netlify": "tsc -b && vite build --outDir=netlify && vite build --base=/queen-bee/ --outDir=netlify/queen-bee",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src e2e playwright.config.ts",
    "lint:fix": "eslint src e2e playwright.config.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react-hooks": "^7",
    "happy-dom": "^20",
    "husky": "^9",
    "prettier": "^3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4",
    "vitest-axe": "1.0.0-pre.5"
  },
  "packageManager": "yarn@4.14.1"
}
